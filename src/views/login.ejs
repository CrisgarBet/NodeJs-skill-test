<!doctype html>
<html lang="es">
  <head>
    <%- include("partials/head", { title: "Iniciar sesión" }) %>
  </head>
  <body>
    <main class="shell narrow">
      <section class="card auth-card">
        <a class="back-link" href="/">← Volver al inicio</a>
        <p class="eyebrow">Bienvenido</p>
        <h1>Iniciar sesión</h1>

        <% if (message.length > 0) { %>
          <div class="alert" role="alert"><%= message[0] %></div>
        <% } %>

        <form action="/login" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="email">Correo electrónico</label>
          <input id="email" type="email" name="email" autocomplete="email" maxlength="254" required autofocus>

          <label for="password">Contraseña</label>
          <input id="password" type="password" name="password" autocomplete="current-password" minlength="8" maxlength="72" required>

          <button class="button primary full" type="submit">Entrar</button>
        </form>
        <p class="form-note">¿No tienes una cuenta? <a href="/signup">Regístrate</a>.</p>
      </section>
    </main>
  </body>
</html>
