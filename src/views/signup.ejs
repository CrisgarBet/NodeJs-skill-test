<!doctype html>
<html lang="es">
  <head>
    <%- include("partials/head", { title: "Crear cuenta" }) %>
  </head>
  <body>
    <main class="shell narrow">
      <section class="card auth-card">
        <a class="back-link" href="/">← Volver al inicio</a>
        <p class="eyebrow">Nueva cuenta</p>
        <h1>Crear cuenta</h1>

        <% if (message.length > 0) { %>
          <div class="alert" role="alert"><%= message[0] %></div>
        <% } %>

        <form action="/signup" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <label for="email">Correo electrónico</label>
          <input id="email" type="email" name="email" autocomplete="email" maxlength="254" required autofocus>

          <label for="password">Contraseña</label>
          <input id="password" type="password" name="password" autocomplete="new-password" minlength="8" maxlength="72" required>
          <small>Usa al menos 8 caracteres y hasta 72 bytes.</small>

          <button class="button primary full" type="submit">Registrarme</button>
        </form>
        <p class="form-note">¿Ya tienes una cuenta? <a href="/login">Inicia sesión</a>.</p>
      </section>
    </main>
  </body>
</html>
