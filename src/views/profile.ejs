<!doctype html>
<html lang="es">
  <head>
    <%- include("partials/head", { title: "Perfil" }) %>
  </head>
  <body>
    <main class="shell">
      <nav class="topbar" aria-label="Navegación principal">
        <a class="brand" href="/">Prueba Jaya</a>
        <form action="/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="button secondary" type="submit">Cerrar sesión</button>
        </form>
      </nav>

      <section class="card">
        <p class="eyebrow">Sesión activa</p>
        <h1>Hola, <%= user.local.email %></h1>
        <p class="lead">Desde aquí puedes ejecutar los tres modos de la prueba.</p>
        <div class="endpoint-grid">
          <a href="/asc"><span>Menor a mayor</span><code>/asc</code></a>
          <a href="/des"><span>Mayor a menor</span><code>/des</code></a>
          <a href="/mix"><span>Dirección alternada</span><code>/mix</code></a>
        </div>
      </section>
    </main>
  </body>
</html>
